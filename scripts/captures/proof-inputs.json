        "expression": "spawn(\"/capture-bun\", [\"--preload\", resolve(root,\"scripts/captures/clock.ts\"), resolve(root,\"scripts/captures/runtime-server.ts\"),scratch,recipe.id], {\n    cwd:root,env:{ PATH:process.env.PATH, TZ:catalogue.environment.timezone },stdio:[\"ignore\",\"pipe\",\"pipe\"],\n  })",
