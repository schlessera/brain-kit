---
import { getCollection, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { publications } from '../../publication.mjs';
import { href, sourceUrl, docNavigation, documentTitle } from '../../model.mjs';
export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map(entry => ({ params: { page: publications[entry.id] }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const title = documentTitle(entry.id);
---
<Page title={`${title} — brain-kit`} description={`Canonical brain-kit documentation: ${title}.`}>
  <main id="main" class="docs-layout">
    <nav class="docs-nav" aria-label="Documentation">
      <a href={href('docs/')} class="docs-home" aria-current={entry.id === 'docs/README.md' ? 'page' : undefined}>Documentation</a>
      {docNavigation.filter(group => group.items.length).map(group => <details open={group.title === 'Get started'} data-current={group.items.some(item => item.source === entry.id) || undefined}><summary>{group.title}</summary><ul>{group.items.map(item => <li><a href={href(`${item.route}/`)} aria-current={item.source === entry.id ? 'page' : undefined}>{item.title}</a></li>)}</ul></details>)}
    </nav>
    <article class="prose"><Content/><footer class="source-links"><ExternalLink href={sourceUrl(entry.id)} data-source-link>View Markdown source</ExternalLink><ExternalLink href={sourceUrl(entry.id, 'blob', 'main')} data-source-link>Edit on GitHub</ExternalLink></footer></article>
  </main>
</Page>
