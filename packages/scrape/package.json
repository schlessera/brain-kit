{
  "name": "@schlessera/brain-scrape",
  "version": "0.20.0",
  "description": "brain-kit scraping base: polite HTTP fetching, robots.txt enforcement, per-host rate limiting, an optional headless-Chrome session, and a config-driven site-adapter seam",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "scraping",
    "robots-txt",
    "rate-limiting",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/scrape"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "robots-parser": "^3.0.1"
  },
  "peerDependencies": {
    "@types/bun": ">=1.3.0",
    "puppeteer-core": "^25.0.4"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "puppeteer-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "puppeteer-core": "^25.0.4",
    "typescript": "^6.0.3"
  }
}
