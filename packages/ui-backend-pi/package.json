{
  "name": "@schlessera/brain-backend-pi",
  "version": "0.34.0",
  "description": "OSS-default brain-kit agent backend, purpose-built on the upstream pi coding-agent SDK",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "pi",
    "ai-agent",
    "chat-backend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/ui-backend-pi"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "@schlessera/brain": "workspace:*",
    "@schlessera/brain-ui-sdk": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "gray-matter": "^4.0.3",
    "typebox": "1.1.38",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@types/bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
