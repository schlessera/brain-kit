{
  "name": "@schlessera/brain-common",
  "version": "0.43.1",
  "description": "Internal brain-kit helpers shared by the @schlessera/brain-* packages: the environment descriptor core, the cache-free frontmatter parser and the worker write-area rules. No compatibility promise.",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "internal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/common"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./internal/env": {
      "bun": "./src/env-core.ts",
      "types": "./dist/env-core.d.ts",
      "default": "./dist/env-core.js"
    },
    "./internal/frontmatter": {
      "bun": "./src/frontmatter-parse.ts",
      "types": "./dist/frontmatter-parse.d.ts",
      "default": "./dist/frontmatter-parse.js"
    },
    "./internal/worker-areas": {
      "bun": "./src/worker-areas.ts",
      "types": "./dist/worker-areas.d.ts",
      "default": "./dist/worker-areas.js"
    },
    "./internal/protected-paths": {
      "bun": "./src/protected-paths.ts",
      "types": "./dist/protected-paths.d.ts",
      "default": "./dist/protected-paths.js"
    },
    "./internal/governance-policy": {
      "bun": "./src/governance-policy.ts",
      "types": "./dist/governance-policy.d.ts",
      "default": "./dist/governance-policy.js"
    },
    "./internal/cache-location": {
      "bun": "./src/cache-location.ts",
      "types": "./dist/cache-location.d.ts",
      "default": "./dist/cache-location.js"
    },
    "./internal/index-location": {
      "bun": "./src/index-location.ts",
      "types": "./dist/index-location.d.ts",
      "default": "./dist/index-location.js"
    },
    "./internal/provider-unavailable": {
      "bun": "./src/provider-unavailable.ts",
      "types": "./dist/provider-unavailable.d.ts",
      "default": "./dist/provider-unavailable.js"
    },
    "./internal/provider-relay": {
      "bun": "./src/provider-relay.ts",
      "types": "./dist/provider-relay.d.ts",
      "default": "./dist/provider-relay.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@types/bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
