{
  "brain_add": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "tags": {
        "type": "string"
      }
    },
    "required": [
      "content"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "brain_apify_abort": {
    "type": "object",
    "properties": {
      "run": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "required": [
      "run"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_apify_approvals": {
    "type": "object",
    "properties": {},
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_apify_availability": {
    "type": "object",
    "properties": {
      "actor_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]{1,64}$"
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_apify_discover": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      }
    },
    "required": [
      "query"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_apify_inspect": {
    "type": "object",
    "properties": {
      "candidate": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "required": [
      "candidate"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_apify_prepare": {
    "type": "object",
    "properties": {
      "candidate": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "input": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "max_charge_usd": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1000000
      }
    },
    "required": [
      "candidate",
      "input",
      "max_charge_usd"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_apify_results": {
    "type": "object",
    "properties": {
      "run": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [
      "run"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_apify_revoke": {
    "type": "object",
    "properties": {
      "actor_id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]{1,64}$"
      }
    },
    "required": [
      "actor_id"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_apify_run": {
    "type": "object",
    "properties": {
      "proposal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "required": [
      "proposal"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_apify_status": {
    "type": "object",
    "properties": {
      "run": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "required": [
      "run"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_archive": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "dry_run": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "path"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "brain_compute_cancel": {
    "type": "object",
    "properties": {
      "job": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "job"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_compute_collect": {
    "type": "object",
    "properties": {
      "job": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "job"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_compute_health": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_compute_plan": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63
      },
      "argv": {
        "minItems": 1,
        "maxItems": 256,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "cwd": {
        "type": "string",
        "maxLength": 1024
      },
      "env": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "source": {
        "maxItems": 1000,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "artifacts": {
        "maxItems": 64,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 1024
            },
            "max_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "lease_seconds": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "retain": {
        "type": "boolean"
      }
    },
    "required": [
      "provider",
      "argv"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_compute_run": {
    "type": "object",
    "properties": {
      "provider": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63
      },
      "argv": {
        "minItems": 1,
        "maxItems": 256,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "cwd": {
        "type": "string",
        "maxLength": 1024
      },
      "env": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "maxLength": 128
        },
        "additionalProperties": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "source": {
        "maxItems": 1000,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "artifacts": {
        "maxItems": 64,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 1024
            },
            "max_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "lease_seconds": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "retain": {
        "type": "boolean"
      }
    },
    "required": [
      "provider",
      "argv"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_compute_status": {
    "type": "object",
    "properties": {
      "job": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "required": [
      "job"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false
  },
  "brain_context": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "max_tokens": {
        "default": 4000,
        "type": "number"
      },
      "include_identity": {
        "default": true,
        "type": "boolean"
      },
      "include_current_focus": {
        "default": true,
        "type": "boolean"
      },
      "include": {
        "maxItems": 64,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "exclude": {
        "maxItems": 64,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "required": [
      "query"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "brain_graph": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "depth": {
        "default": 1,
        "type": "number"
      },
      "direction": {
        "default": "both",
        "type": "string",
        "enum": [
          "outgoing",
          "incoming",
          "both"
        ]
      }
    },
    "required": [
      "path"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "brain_list": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string"
      },
      "tag": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "relevance": {
        "type": "string"
      },
      "limit": {
        "default": 20,
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "path_prefix": {
        "type": "string"
      },
      "overview": {
        "type": "boolean"
      },
      "cursor": {
        "type": "string"
      }
    },
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "brain_read": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "section": {
        "type": "string"
      },
      "max_tokens": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "path"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "brain_read_many": {
    "type": "object",
    "properties": {
      "requests": {
        "minItems": 1,
        "maxItems": 20,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "section": {
              "type": "string",
              "maxLength": 512
            },
            "offset": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expected_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      "max_total_chars": {
        "type": "integer",
        "minimum": 2000,
        "maximum": 40000
      },
      "max_item_chars": {
        "type": "integer",
        "minimum": 512,
        "maximum": 40000
      }
    },
    "required": [
      "requests"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "brain_search": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "tag": {
        "type": "string"
      },
      "relevance": {
        "type": "string"
      },
      "mode": {
        "default": "hybrid",
        "type": "string",
        "enum": [
          "fts",
          "vector",
          "hybrid"
        ]
      },
      "rerank": {
        "type": "string",
        "enum": [
          "none",
          "heuristic",
          "jev"
        ]
      },
      "include_archived": {
        "default": false,
        "type": "boolean"
      },
      "assets_only": {
        "default": false,
        "type": "boolean"
      },
      "limit": {
        "default": 10,
        "type": "number"
      },
      "updated_since": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "updated_before": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "deadline_from": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "deadline_to": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "sort": {
        "type": "string",
        "enum": [
          "score",
          "updated",
          "deadline"
        ]
      },
      "upcoming": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "query"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "brain_update": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "summary": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "archived",
          "draft"
        ]
      },
      "relevance": {
        "type": "string",
        "enum": [
          "primary",
          "secondary",
          "historical"
        ]
      },
      "tags": {
        "type": "string"
      },
      "deadline": {
        "type": "string"
      },
      "next_review": {
        "type": "string"
      },
      "append_content": {
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}
