#!/bin/sh
# pre-commit — `brain validate` always (errors block the commit; warnings do
# not). Tests + typecheck run only when tooling changed (brain.config.* or
# .agents/skills/). Bypass everything with: BRAIN_SKIP_HOOKS=1 git commit ...
set -eu

[ "${BRAIN_SKIP_HOOKS:-0}" = "1" ] && exit 0

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT"

# Resolve the brain CLI: PATH first, then the repo's pinned bin.
if command -v brain >/dev/null 2>&1; then
  BRAIN="brain"
elif [ -x "$ROOT/node_modules/.bin/brain" ]; then
  BRAIN="$ROOT/node_modules/.bin/brain"
else
  echo "pre-commit: brain CLI not found — skipping validation" >&2
  exit 0
fi

"$BRAIN" validate >/dev/null || {
  echo "pre-commit: brain validate failed — fix errors or use BRAIN_SKIP_HOOKS=1" >&2
  "$BRAIN" validate 2>&1 | grep -E '\[ERROR\]' >&2 || true
  exit 1
}

# Tooling changes must additionally pass tests + typecheck, when those tools exist.
if git diff --cached --name-only | grep -qE '^(brain\.config\.(ts|json)|\.agents/skills/)'; then
  if command -v bun >/dev/null 2>&1; then
    if [ -f "$ROOT/tsconfig.json" ]; then
      bunx tsc --noEmit || {
        echo "pre-commit: typecheck failed (bunx tsc --noEmit)" >&2
        exit 1
      }
    fi
    # `bun test` treats "no test files" as an error rather than a vacuous
    # pass, and a brand-new brain has none — which rejected the very first
    # commit /brain-init makes, the one the interview promises as its revert
    # point.
    #
    # Do NOT tell the two apart by what bun printed. The first version of this
    # did, and CI disproved it inside an hour: bun 1.3.14 says "0 test files
    # matching …" on one machine and "No tests found!" on another. Its prose is
    # not an interface.
    #
    # So ask the filesystem, with a pattern deliberately WIDER than bun's
    # (anything named like a test, not just its four exact forms). Wider errs
    # toward reporting a failure — a file called `latest.ts` would make a
    # genuine "no tests" read as a failed run, which is loud and gets fixed.
    # Narrower would let real tests stop running silently, and this repo has
    # paid for that once already.
    if ! TEST_OUTPUT=$(bun test 2>&1); then
      MAYBE_TESTS=$(find "$ROOT" \
        \( -name node_modules -o -name .git \) -prune -o \
        -type f \( -name '*test*.js' -o -name '*test*.jsx' \
                 -o -name '*test*.ts' -o -name '*test*.tsx' \
                 -o -name '*spec*.js' -o -name '*spec*.jsx' \
                 -o -name '*spec*.ts' -o -name '*spec*.tsx' \) \
        -print 2>/dev/null | head -n 1)
      if [ -n "$MAYBE_TESTS" ]; then
        echo "pre-commit: tests failed (bun test)" >&2
        printf '%s\n' "$TEST_OUTPUT" | tail -20 >&2
        exit 1
      fi
      echo "pre-commit: no tests in this brain — nothing to run" >&2
    fi
  fi
fi

exit 0
