{
  "name": "@schlessera/brain",
  "version": "0.10.0",
  "description": "File-first personal knowledge base operated by coding agents: CLI, hybrid search, MCP server, skills",
  "license": "MIT",
  "keywords": [
    "personal-knowledge-base",
    "knowledge-management",
    "mcp",
    "cli",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "sideEffects": false,
  "type": "module",
  "bin": {
    "brain": "./dist/cli/brain.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "skills",
    "CONTRACT.md",
    "README.md"
  ],
  "scripts": {
    "test": "bun test tests",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@schlessera/brain-render-template": "workspace:*",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-metrics": "^2.4.0",
    "gray-matter": "^4.0.3",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@google/genai": "^2.10.0",
    "@types/bun": ">=1.3.0",
    "@schlessera/brain-render-puppeteer": "*"
  },
  "peerDependenciesMeta": {
    "@google/genai": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    },
    "@schlessera/brain-render-puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google/genai": "^2.10.0",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
