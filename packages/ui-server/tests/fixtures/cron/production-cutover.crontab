# Generated by entrypoint.sh — regenerated on each container start.
PATH=/root/.local/bin:/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Base jobs
0 2 * * * root cd /data/brain && /opt/brain-ui/server/node_modules/.bin/brain-ui-cron run sync -- sh -c 'brain sync && brain index' 2>&1 | logger -t brain-sync
0 3 * * * root cd /data/brain && /opt/brain-ui/server/node_modules/.bin/brain-ui-cron run validate -- brain validate 2>&1 | logger -t brain-validate
0 7 * * * root cd /data/brain && /opt/brain-ui/server/node_modules/.bin/brain-ui-cron run maintain -- brain maintain 2>&1 | logger -t brain-maintain
30 7 * * * root cd /data/brain && /opt/brain-ui/server/node_modules/.bin/brain-ui-cron run digest -- /opt/brain-ui/server/node_modules/.bin/brain-ui-cron digest 2>&1 | logger -t brain-digest

# Module jobs (from enabled modules' cron manifests, when exposed)
0 6 * * * root cd /data/brain && /opt/brain-ui/server/node_modules/.bin/brain-ui-cron run jobs-scrape -- brain jobs scrape --all --browser 2>&1 | logger -t brain-jobs-scrape
15 8 * * 1 root cd /data/brain && /opt/brain-ui/server/node_modules/.bin/brain-ui-cron run finance-remind -- brain finance reminders 2>&1 | logger -t brain-finance-remind

