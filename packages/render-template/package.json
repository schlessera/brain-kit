{
  "name": "@schlessera/brain-render-template",
  "version": "0.40.0",
  "description": "Shared markdown/HTML \u2192 print-ready document shell, components and document kinds for brain-kit (used by the UI's /api/render and the CLI's `brain render`)",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "markdown",
    "html",
    "pdf",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/render-template"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kinds": {
      "bun": "./src/kinds.ts",
      "types": "./dist/kinds.d.ts",
      "default": "./dist/kinds.js"
    },
    "./package.json": "./package.json",
    "./links": {
      "bun": "./src/links.ts",
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./internal": {
      "bun": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "src",
    "dist",
    "skeletons"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "marked": "^18.0.4",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
