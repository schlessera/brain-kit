{
  "name": "@schlessera/brain-render-template",
  "version": "0.26.0",
  "description": "Shared markdown/HTML → print-ready document shell for brain-kit (used by the UI's /api/render and the CLI's `brain render`)",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "markdown",
    "html",
    "pdf",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/render-template"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
