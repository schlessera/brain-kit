{
  "name": "@schlessera/brain-module-jobs",
  "version": "0.23.0",
  "description": "brain-kit module: job-search pipeline — board scraping, scoring, dedup, triage",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "jobs",
    "job-search",
    "scraping"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/module-jobs"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "bun": "./src/module.ts",
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "skills",
    "README.md"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "@schlessera/brain": "workspace:*",
    "@schlessera/brain-scrape": "workspace:*",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@types/bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
