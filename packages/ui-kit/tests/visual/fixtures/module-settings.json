    "fields": [
      {
        "key": "scoring",
        "label": "Scoring",
        "kind": "record",
        "group": "Scoring",
        "fields": [
          {
            "key": "groups",
            "label": "Scoring groups",
            "kind": "list",
            "itemTitle": "name",
            "collapsible": true,
            "orderMatters": true,
            "minItems": 1,
            "uniqueBy": "name",
            "addLabel": "Add group",
            "fields": [
              {
                "key": "name",
                "label": "Name",
                "kind": "text",
                "help": "Shown in each job's score breakdown."
              },
              {
                "key": "weight",
                "label": "Maximum points",
                "kind": "number",
                "unit": "points"
              },
              {
                "key": "match",
                "label": "Look in",
                "kind": "choice",
                "default": "all",
                "options": [
                  {
                    "value": "all",
                    "label": "Title and description"
                  },
                  {
                    "value": "title",
                    "label": "Title only"
                  }
                ]
              },
              {
                "key": "titleBoost",
                "label": "Title boost",
                "kind": "number",
                "unit": "×",
                "step": 0.1,
                "default": 1,
                "help": "Multiplies a tier's points when its keyword is in the title."
              },
              {
                "key": "",
                "label": "Scoring style",
                "kind": "variant",
                "variants": [
                  {
                    "key": "tiers",
                    "label": "Graded tiers",
                    "fields": [
                      {
                        "key": "tiers",
                        "label": "Tiers",
                        "kind": "list",
                        "itemTitle": "points",
                        "orderMatters": true,
                        "minItems": 1,
                        "addLabel": "Add tier",
                        "fields": [
                          {
                            "key": "points",
                            "label": "Points",
                            "kind": "number",
                            "unit": "points"
                          },
                          {
                            "key": "keywords",
                            "label": "Keywords",
                            "kind": "tags",
                            "help": "Matched without regard to case."
                          }
                        ],
                        "help": "The best matching tier counts, up to the group's maximum."
                      }
                    ]
                  },
                  {
                    "key": "keywords",
                    "label": "One keyword list",
                    "fields": [
                      {
                        "key": "keywords",
                        "label": "Keywords",
                        "kind": "tags",
                        "help": "Any match scores the group's maximum."
                      }
                    ]
                  }
                ]
              }
            ],
            "help": "Each group adds up to its maximum points."
          },
          {
            "key": "location",
            "label": "Location",
            "kind": "record",
            "optional": {
              "label": "Score location"
            },
            "fields": [
              {
                "key": "weight",
                "label": "Points when preferred",
                "kind": "number",
                "unit": "points"
              },
              {
                "key": "preferred",
                "label": "Preferred markers",
                "kind": "tags",
                "help": "Whole words, such as remote, europe."
              },
              {
                "key": "excluded",
                "label": "Excluded markers",
                "kind": "tags",
                "help": "Any excluded marker scores location zero, even when a preferred marker matches."
              }
            ]
          },
          {
            "key": "excludeTitles",
            "label": "Never show titles containing",
            "kind": "tags",
            "help": "A matching title scores zero in every group."
          },
          {
            "key": "compensationBenchmark",
            "label": "Salary benchmark (annual)",
            "kind": "number",
            "unit": "/ year",
            "currency": "EUR",
            "minorUnits": true,
            "optional": {
              "label": "Score salary"
            },
            "help": "Listings are converted to EUR cents with the rates below."
          },
          {
            "key": "compensationWeight",
            "label": "Points at or above the benchmark",
            "kind": "number",
            "unit": "points",
            "default": 0,
            "help": "Half at 80% of it; 30% when a listing gives no salary."
          },
          {
            "key": "queueThreshold",
            "label": "Queue for review at",
            "kind": "number",
            "unit": "points",
            "default": 60
          },
          {
            "key": "dismissThreshold",
            "label": "Dismiss below",
            "kind": "number",
            "unit": "points",
            "default": 35
          }
        ]
      },
