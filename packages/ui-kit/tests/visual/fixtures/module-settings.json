            "label": "NoDesk",
            "disabled": false,
            "help": "Not selected by default · Needs a browser on the host"
          },
          {
            "value": "simplyhired",
            "label": "SimplyHired",
            "disabled": false,
            "help": "Not selected by default · Uses your queries · intermittent 403s (rate limiting) from the measured vantage point"
          },
          {
            "value": "jobgether",
            "label": "Jobgether",
            "disabled": false,
            "help": "Not selected by default · robots.txt disallows its API's query-string paging, so a run gets one page"
          },
          {
            "value": "dice",
            "label": "Dice",
            "disabled": false,
            "help": "Not selected by default · Uses your queries · Needs a browser on the host"
          },
          {
            "value": "remotelyde",
            "label": "Remotely.de",
            "disabled": false,
            "help": "Not selected by default"
          }
        ]
      },
      {
        "key": "queries",
        "label": "Queries",
        "kind": "tags",
        "group": "Sources",
        "help": "Used by SimplyHired and Dice only."
      },
      {
        "key": "rates",
        "label": "Currency → EUR rates",
        "kind": "weights",
        "group": "Conversion",
        "help": "Overrides the package's built-in rates, which go stale."
      },
      {
        "key": "enrichment.maxDetailPages",
        "label": "Maximum detail pages",
        "kind": "number",
        "unit": "pages",
        "group": "Enrichment",
        "help": "Zero turns enrichment off."
      },
      {
        "key": "enrichment.concurrency",
        "label": "Concurrent detail requests",
        "kind": "number",
        "unit": "requests",
        "group": "Enrichment"
