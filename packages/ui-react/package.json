{
  "name": "@schlessera/brain-ui-react",
  "version": "0.23.0",
  "description": "brain-kit chat-UI React components: chat surface, tool-call timeline, file browser, voice dictation, stores, and WebSocket transport",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "react",
    "chat",
    "ui",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/ui-react"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "@schlessera/brain-ui-sdk": "workspace:*",
    "@simplewebauthn/browser": "^13.2.2",
    "clsx": "^2",
    "framer-motion": "^12.38.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^0.460",
    "mermaid": "^11.12.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sigma": "^3",
    "tailwind-merge": "^3",
    "zustand": "^5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@tailwindcss/cli": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
