{
  "name": "@schlessera/brain-module-diagrams",
  "version": "0.43.1",
  "description": "Diagram module scaffold and upstream review tooling for brain-kit",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "diagrams"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/module-diagrams"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "bun": "./src/module.ts",
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./package.json": "./package.json",
    "./ui": {
      "bun": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./render": {
      "bun": "./src/render.ts",
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    }
  },
  "files": [
    "src",
    "dist",
    "skills",
    "scripts",
    "UPSTREAM.md",
    "upstream.json"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "@schlessera/brain": "workspace:*",
    "zod": "^4.4.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@types/bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
