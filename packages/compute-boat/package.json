{
  "name": "@schlessera/brain-compute-boat",
  "version": "0.44.0",
  "description": "brain-kit external compute provider for Boat sandboxes: the `boat` built-in, plain fetch transport mapped to the ComputeProvider contract",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "external-compute",
    "boat",
    "sandbox",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/compute-boat"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.5"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@schlessera/brain": "*",
    "@types/bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@schlessera/brain": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    }
  },
  "devDependencies": {
    "@schlessera/brain": "workspace:*",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
