{
  "name": "@schlessera/brain-ui-sdk",
  "version": "0.36.0",
  "description": "brain-kit chat-UI SDK: the wire protocol, AgentBackend/SpeechProvider server seams, and client renderer/ASR registries",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "sdk",
    "chat",
    "ai-agents",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/ui-sdk"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "bun": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./schemas": {
      "bun": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./tool-contracts": {
      "bun": "./src/tool-contracts/index.ts",
      "types": "./dist/tool-contracts/index.d.ts",
      "default": "./dist/tool-contracts/index.js"
    },
    "./server": {
      "bun": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./client": {
      "bun": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./share-target": {
      "bun": "./src/client/share-target.ts",
      "types": "./dist/client/share-target.d.ts",
      "default": "./dist/client/share-target.js"
    },
    "./push-handlers": {
      "bun": "./src/client/push-handlers.ts",
      "types": "./dist/client/push-handlers.d.ts",
      "default": "./dist/client/push-handlers.js"
    },
    "./sw-policy": {
      "bun": "./src/client/sw-policy.ts",
      "types": "./dist/client/sw-policy.d.ts",
      "default": "./dist/client/sw-policy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "typescript": "^6.0.3"
  }
}
