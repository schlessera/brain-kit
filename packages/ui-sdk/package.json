{
  "name": "@endoxa/ui-sdk",
  "version": "0.1.0",
  "description": "endoxa chat-UI SDK: the wire protocol, AgentBackend/SpeechProvider server seams, and client renderer/ASR registries",
  "license": "MIT",
  "keywords": [
    "endoxa",
    "sdk",
    "chat",
    "ai-agents",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endoxa/endoxa.git",
    "directory": "packages/ui-sdk"
  },
  "homepage": "https://endoxa.app",
  "bugs": {
    "url": "https://github.com/endoxa/endoxa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "bun": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./schemas": {
      "bun": "./src/schemas.ts",
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./server": {
      "bun": "./src/server/index.ts",
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "bun": "./src/client/index.ts",
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "test": "bun test tests"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "typescript": "^6.0.3"
  }
}
