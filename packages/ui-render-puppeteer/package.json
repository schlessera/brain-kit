{
  "name": "@schlessera/brain-render-puppeteer",
  "version": "0.39.0",
  "description": "Optional server-side HTML\u2192PNG/PDF renderer for brain-kit UIs (Puppeteer, network-denied by default)",
  "license": "MIT",
  "keywords": [
    "brain-kit",
    "puppeteer",
    "renderer",
    "pdf",
    "screenshot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schlessera/brain-kit.git",
    "directory": "packages/ui-render-puppeteer"
  },
  "homepage": "https://github.com/schlessera/brain-kit",
  "bugs": {
    "url": "https://github.com/schlessera/brain-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "test": "bun test tests --timeout 30000",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.0.4",
    "@schlessera/brain-render-template": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
