{
  "name": "@endoxa/ui-render-puppeteer",
  "version": "0.1.0",
  "description": "Optional server-side HTML→PNG/PDF renderer for endoxa UIs (Puppeteer, network-denied by default)",
  "license": "MIT",
  "keywords": [
    "endoxa",
    "puppeteer",
    "renderer",
    "pdf",
    "screenshot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endoxa/endoxa.git",
    "directory": "packages/ui-render-puppeteer"
  },
  "homepage": "https://endoxa.app",
  "bugs": {
    "url": "https://github.com/endoxa/endoxa/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "test": "bun test tests",
    "prepublishOnly": "bun ../../scripts/check-dist.ts"
  },
  "dependencies": {
    "puppeteer-core": "^25.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
