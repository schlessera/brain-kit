# Copy this file to `.env` and uncomment what you need. `.env` is gitignored —
# never commit your keys.

# GEMINI_API_KEY — optional. Enables semantic (vector/hybrid) search, asset
# descriptions, and richer `/whatsup` skill output (built on `brain briefing`).
# The free tier is plenty for a personal brain. Without it, everything falls
# back to full-text search. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
