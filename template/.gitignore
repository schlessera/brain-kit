# --- brain-kit defaults ---

# Search index — disposable. Markdown is the source of truth; `brain index
# --force` rebuilds this from scratch.
brain.db*

# Secrets — your API keys live here.
.env

# Dependencies.
node_modules/

# Per-task agent working directories.
workspaces/*/

# brain-ui's scratch space inside the content repo: the keyterm and model
# caches, and shares staged from the system share sheet before the agent files
# them. All of it is regenerated or transient, and a staged share can hold
# anything you happened to share — never commit it.
.brain-ui/

# The brain's scratch area: transient output (renders, image drafts) that is
# never part of the brain. Pruned after 7 days or past 1 GB; move a file out of
# it to keep it.
.brain/scratch/

# Tool leftovers: OS metadata, editor swap and backup files, LaTeX
# byproducts. `brain sync` treats the same list as artifacts, and
# `brain doctor` points out any that were committed before this was here.
.DS_Store
Thumbs.db
Desktop.ini
*:Zone.Identifier
*.swp
*.swo
*~
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# Add your own ignores below (local extensions, anything else you keep out).
