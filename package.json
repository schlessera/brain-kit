{
  "name": "brain-kit-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "check-dist-types": "bun scripts/check-dist-types.ts",
    "clean": "bun scripts/clean.ts",
    "env-docs": "bun scripts/env-docs.ts",
    "lint": "bun scripts/lint.ts",
    "api-report": "bun scripts/api-report.ts",
    "test": "bun scripts/test.ts --timeout 30000",
    "check:pr": "bun scripts/check-pr.ts",
    "check:pack": "bun scripts/check-packages.ts",
    "test:browser": "node scripts/visual.mjs",
    "test:layout": "node scripts/visual.mjs --project=ui-react-layout",
    "visual": "node scripts/visual.mjs --project=visual --project=subjects",
    "visual:update": "node scripts/visual.mjs --project=visual --project=subjects --update",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version && rm -f bun.lock && bun install",
    "release": "bun install && bun run build && bun scripts/publish.ts",
    "captures": "bun scripts/capture.ts",
    "capture:fonts": "bun scripts/capture.ts --prepare-fonts",
    "capture:verify": "bun scripts/captures/verify.ts",
    "website:build": "bun website/scripts/build.ts",
    "website:check": "bun website/scripts/build.ts --check",
    "website:preview": "bun website/scripts/preview.ts",
    "website:shares": "bun website/scripts/build.ts --refresh-shares"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.4.2",
    "axe-core": "^4.13.0",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "oxlint": "^1.79.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5"
  }
}
