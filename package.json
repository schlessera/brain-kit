{
  "name": "brain-kit-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "clean": "bun scripts/clean.ts",
    "test": "bun test packages",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun install && bun run build && bun scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
